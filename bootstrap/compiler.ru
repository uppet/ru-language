    若 函 != 空 则
        函['可调表'] 其 逐目 作 键 值: 设 函表 键 值. 为.
        函['可值表'] 其 逐目 作 键 值: 设 值名 键 真. 为.
    然.
    状 取 {'全':全,'文件':模块['文件'],'函数':函,'名函数':函表,'值名':值名,'行文':[],'入口':[],'位数':0,
           '停':假,'环境栈':[],'环栈':[],'救栈':[],'末处':(新号 全 'finish'),'卒处':(新号 全 'panic')}.
    旧源 取 调用 状 'source' ([(字符串 状 模块['文件'])]).
    环境 取 '%global'.
    若 函 != 空 则 环境 取 调用 状 'env_new' (['%global','1',(函['行'] 为 句)]). 然.
    设 状 '环境' 环境.
    若 函 != 空 则
        序 取 0. 参 取 函['参'].
        循 (参 其 量) 次
            调用 状 'bind_arg' ([环境,(字符串 状 参[序][0]),'%args',(序 为 句)]). 序 取 序+1.
        环.
    然.
    提升 状 体. 发块 状 体.
    若 非 状['停'] 则
        若 函 != 空 且 非 函['作'] 则 调用 状 'missing_return' ([(字符串 状 函['名']),'%call_line']). 然.
        跳 状 状['末处'].
    然.
    标记 状 状['卒处']. 调用 状 'null' (['%out']). 跳 状 状['末处'].
    标记 状 状['末处'].
    若 函 != 空 则 调用 状 'env_free' ([环境]). 然.
    调用 状 'frame_free' (['%frame']). 调用 状 'source_restore' ([旧源]). 行出 状 'ret void'.
    出 取 ['define void @'+名+'(i8* %global, i8* %self, i32 %call_line, i8* %args, i8* %out) {','entry:',
             '  %frame = call i8* @rul_frame_new(i32 '+(状['位数'] 为 句)+')'].
    序 取 0. 循 (状['入口'] 其 量) 次 出 其 增 状['入口'][序]. 序 取 序+1. 环.
    序 取 0. 循 (状['行文'] 其 量) 次 出 其 增 状['行文'][序]. 序 取 序+1. 环.
