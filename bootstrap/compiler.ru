        类指 其 增 ('&'+名). 序 取 序+1.
    环.
    若 (类指 其 量) == 0 则 类指 其 增 'NULL'. 然.
    出 其 增 ('static RuClass *rul_classes[] = {'+(__如竞 其 合句 类指 ',')+'};').
    出 其 增 'static RuClass *rul_class_descriptor(int32_t id) { return rul_classes[id]; }'.
    序 取 0. 模块列 取 全['模块'].
    循 (模块列 其 量) 次
        模块 取 模块列[序]. 名 取 'boot_m_'+(序 为 句).
        出 其 增 ('static Env '+名+'_env; static int '+名+'_state; static RuModuleFailure '+名+'_failure;').
        出 其 增 ('extern void '+名+'_llvm(void *,void *,int32_t,void *,void *);').
        出 其 增 ('static Val '+名+'_init(void) {').
        出 其 增 ('if ('+名+'_state==2) return v_module(&'+名+'_env);').
        出 其 增 ('if ('+名+'_state==3) return ru_module_failure_raise(&'+名+'_failure);').
        出 其 增 ('if ('+名+'_state==1) ru_fail(1,"循环外言");').
        出 其 增 (名+'_state=1; const char *old=ru_source; ru_source='+(C串 模块['文件'])+';').
        出 其 增 ('env_init(&'+名+'_env,ru_practical_builtins()); Val out=v_null(); '+名+'_llvm(&'+名+'_env,NULL,0,NULL,&out); v_drop(out);').
        出 其 增 ('if (ru_panicking) { ru_module_failure_save(&'+名+'_failure); '+名+'_state=3; ru_source=old; return v_null(); }').
        出 其 增 (名+'_state=2; ru_source=old; return v_module(&'+名+'_env); }'). 序 取 序+1.
    环.
    出 其 增 'static Val rul_module_import(int32_t id) { switch(id) {'. 序 取 0.
    循 (模块列 其 量) 次
        出 其 增 ('case '+(序 为 句)+': return boot_m_'+(序 为 句)+'_init();'). 序 取 序+1.
    环.
    出 其 增 'default: ru_fail(0,"自举外言索引越界"); return v_null(); } }'.
    得 (__如竞 其 合句 出 '\n')+'\n'.
