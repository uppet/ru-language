# Private bootstrap dense subset. No source parsing or runtime borrows here.
# Input AST is the existing bootstrap AST; contracts use ordered name/type pairs.
算 密设 表 名 值:
    表 其 增 名 值. 得 空.
法.
算 密含 列 值:
    得 (列 其 查 值) != 空.
法.
算 密错 状 节 文:
    卒 状['file']+':'+(节['行'] 为 句)+':'+(节['列'] 为 句)+': error: 自举密编译错误：'+文.
法.
算 密拷 表:
    新表 取 {}.
    表 其 逐目 作 名 值: 密设 新表 名 值. 为.
    得 新表.
法.
算 密标 型:
    得 型 == 'u8' 或 型 == 'u32'.
法.
算 密知 状 节:
    种 取 节['种'].
    若 种 == 'name' 则 得 状['env'][节['名']]. 然.
    若 种 == 'index' 则 得 'u8'. 然.
    若 种 == 'member' 且 节['名'] == '量' 则 得 'u32'. 然.
    若 种 == 'fact' 则 得 'fact'. 然.
    若 种 == 'binary' 则
        若 密含 ['==','!=','<','<=','>','>=','且','或'] 节['算符'] 则 得 'fact'. 然.
        型 取 密知 状 节['左']. 若 型 != 空 则 得 型. 然. 得 密知 状 节['右'].
    然. 得 空.
法.
算 密真 状 节:
    期 取 空. 若 节['种'] == 'number' 则 期 取 'u32'. 然.
    值 取 密式 状 节 期.
    若 非 (密标 值[1]) 且 值[1] != 'fact' 则 密错 状 节 '条件不得是借用视图'. 然.
    得 ['truth',值[0]].
法.
算 密式 状 节 期:
    配 取 密原式 状 节 期.
    若 期 != 空 且 配[1] != 期 则 密错 状 节 '表达式类型不匹配；不得隐式转换'. 然.
    得 [['at',节['行'],节['列'],配[0]],配[1]].
法.
算 密原式 状 节 期:
    种 取 节['种'].
    若 种 == 'number' 则
        若 非 (密标 期) 则 密错 状 节 '整数字面量需要类型上下文'. 然.
        字 取 __如竞 其 字列 节['值']. 序 取 0. 值 取 0. 上限 取 4294967295.
        若 期 == 'u8' 则 上限 取 255. 然.
        若 (字 其 量) == 0 则 密错 状 节 '空整数字面量'. 然.
        循 (字 其 量) 次
            若 字[序] < '0' 或 字[序] > '9' 则 密错 状 节 '仅支持精确十进制整数字面量'. 然.
            值 取 值*10+(字[序] 为 数).
            若 值 > 上限 则 密错 状 节 '整数字面量超出类型范围'. 然.
            序 取 序+1.
        环. 得 [['const',期,值],期].
    然.
    若 种 == 'fact' 则 得 [['const','fact',节['值']],'fact']. 然.
    若 种 == 'name' 则
        名 取 节['名']. 若 状['assigned'][名] == 空 则 密错 状 节 ('未知或未初始化名称：'+名). 然.
        得 [['var',名],状['env'][名]].
    然.
    若 种 == 'index' 则
        左 取 密式 状 节['左'] 空. 位 取 密式 状 节['位'] 'u32'.
        若 左[1] != 'borrow_ro_u8' 则 密错 状 节 '索引只支持只读字节视图'. 然.
        得 [['load',左[0],位[0]],'u8'].
    然.
    若 种 == 'member' 且 节['名'] == '量' 且 (节['参'] 其 量) == 0 则
        左 取 密式 状 节['左'] 空.
        若 左[1] != 'borrow_ro_u8' 则 密错 状 节 '量只支持只读字节视图'. 然.
        得 [['length',左[0]],'u32'].
    然.
    若 种 == 'unary' 且 节['算符'] == '非' 则 得 [['not',(密真 状 节['值'])],'fact']. 然.
    若 种 == 'binary' 则
        运 取 节['算符'].
        若 运 == '且' 或 运 == '或' 则
            操 取 'and'. 若 运 == '或' 则 操 取 'or'. 然.
            得 [[操,(密真 状 节['左']),(密真 状 节['右'])],'fact'].
        然.
        操 取 {'+':'add','-':'sub','==':'eq','!=':'ne','<':'lt','<=':'le','>':'gt','>=':'ge'}[运].
        若 操 == 空 则 密错 状 节 '不支持的密运算'. 然.
        型 取 密知 状 节['左']. 若 型 == 空 则 型 取 密知 状 节['右']. 然. 若 型 == 空 则 型 取 期. 然.
        若 非 (密标 型) 则 密错 状 节 '运算需要一致的整数类型'. 然.
        左 取 密式 状 节['左'] 型. 右 取 密式 状 节['右'] 型.
        返 取 'fact'. 若 运 == '+' 或 运 == '-' 则 返 取 型. 然.
        得 [[操,左[0],右[0]],返].
    然.
    密错 状 节 ('不支持的 AST／效果：'+种). 得 空.
法.
算 密块 状 体 循内:
    出 取 []. 序 取 0.
    循 (体 其 量) 次
        节 取 体[序]. 种 取 节['种'].
        若 种 == 'bind' 则
            名 取 节['名']. 若 状['params'][名] != 空 则 密错 状 节 '不得重绑定参数'. 然.
            期 取 状['env'][名]. 若 期 == 空 则 期 取 状['hints'][名]. 然.
            值 取 密式 状 节['值'] 期.
            若 非 (密标 值[1]) 则 密错 状 节 '局部须为整数；借用不得保存'. 然.
            若 状['env'][名] == 空 则 状['locals'] 其 增 [名,值[1]]. 然.
            密设 状['env'] 名 值[1]. 密设 状['assigned'] 名 真.
            出 其 增 ['set',名,值[0]].
        另若 种 == 'if' 则
            条 取 密真 状 节['条']. 前 取 密拷 状['assigned'].
            是 取 密块 状 节['是'] 循内. 后是 取 状['assigned'].
            密设 状 'assigned' (密拷 前). 否 取 密块 状 节['否'] 循内.
            后是 其 逐目 作 名 值:
                若 状['assigned'][名] != 空 则 密设 前 名 真. 然.
            为.
            密设 状 'assigned' 前. 出 其 增 ['if',条,是,否].
        另若 种 == 'loop' 则
            若 节['次'] == 空 则 密错 状 节 '仅支持有界循次'. 然.
            次数 取 密式 状 节['次'] 'u32'. 前 取 密拷 状['assigned'].
            内 取 密块 状 节['体'] 真. 密设 状 'assigned' 前.
            出 其 增 ['repeat',次数[0],内].
        另若 种 == 'break' 且 循内 则 出 其 增 ['break'].
        另若 种 == 'return' 则
            值 取 密式 状 节['值'] 状['result']. 出 其 增 ['return',值[0]].
        另 密错 状 节 ('不支持的语句／效果：'+种).
        然. 序 取 序+1.
    环. 得 出.
法.
算 密降型 函 约 文件:
    状 取 {'file':文件,'env':{},'params':{},'hints':{},'assigned':{},'locals':[],'result':约['result']}.
    若 函['作'] 或 非 (密标 约['result']) 则 密错 状 函 '仅支持返回整数的算'. 然.
    效果 取 ['borrow-read','no-escape','no-callback','no-gc','may-fail']. 序 取 0.
    若 (约['effects'] 其 量) != 5 则 密错 状 函 '效果合同必须完整匹配'. 然.
    循 5 次
        若 约['effects'][序] != 效果[序] 则 密错 状 函 '效果合同必须完整匹配'. 然. 序 取 序+1.
    环.
    参 取 约['params']. 若 (参 其 量) != (函['参'] 其 量) 则 密错 状 函 '清单参数不匹配'. 然.
    序 取 0. 视数 取 0. 型参 取 [].
    循 (参 其 量) 次
        配 取 参[序]. 名 取 配[0]. 型 取 配[1].
        若 名 != 函['参'][序][0] 或 函['参'][序][1] != '' 或 状['params'][名] != 空 则 密错 状 函 '参数顺序／注解／重复不匹配'. 然.
        若 型 == 'borrow_ro_utf8' 则 型 取 'borrow_ro_u8'. 视数 取 视数+1.
        另若 非 (密标 型) 则 密错 状 函 '仅支持 UTF8 借用及 u8/u32'. 然.
        密设 状['params'] 名 型. 密设 状['env'] 名 型. 密设 状['assigned'] 名 真.
        型参 其 增 [名,型]. 序 取 序+1.
    环.
    若 视数 > 1 则 密错 状 函 '仅支持一个只读借用'. 然.
    范围 取 约['ranges']. 若 范围 == 空 则 范围 取 []. 然. 序 取 0.
    循 (范围 其 量) 次
        约束 取 范围[序].
        若 (约束 其 量) != 3 或 状['params'][约束['view']] != 'borrow_ro_u8' 或 状['params'][约束['begin']] != 'u32' 或 状['params'][约束['end']] != 'u32' 则 密错 状 函 '范围合同无效'. 然.
        序 取 序+1.
    环.
    提示 取 约['locals']. 若 提示 == 空 则 提示 取 []. 然. 序 取 0.
    循 (提示 其 量) 次
        配 取 提示[序]. 若 非 (密标 配[1]) 或 状['hints'][配[0]] != 空 则 密错 状 函 '局部类型提示无效'. 然.
        密设 状['hints'] 配[0] 配[1]. 序 取 序+1.
    环.
    体 取 密块 状 函['体'] 假.
    若 (体 其 量) == 0 则 密错 状 函 '须明确返回标量'. 然.
    若 体[(体 其 量)-1][0] != 'return' 则 密错 状 函 '末尾须明确返回标量'. 然.
    序 取 0. 循 (提示 其 量) 次
        若 状['env'][提示[序][0]] == 空 或 状['params'][提示[序][0]] != 空 则 密错 状 函 '未定义的局部提示'. 然. 序 取 序+1.
    环.
    得 {'params':型参,'locals':状['locals'],'body':体,'result':约['result']}.
法.
算 密型 型:
    得 {'u8':'i8','u32':'i32','fact':'i1'}[型].
法.
算 密鲜 状 前:
    密设 状 'serial' (状['serial']+1). 得 前+(状['serial'] 为 句).
法.
算 密行 状 文:
    状['lines'] 其 增 ('  '+文). 得 空.
法.
算 密值 状 文:
    名 取 '%'+(密鲜 状 't'). 密行 状 (名+' = '+文). 得 名.
法.
算 密签 状 名:
    状['lines'] 其 增 (名+':'). 密设 状 'current' 名. 密设 状 'ended' 假. 得 空.
法.
算 密跳 状 名:
    密行 状 ('br label %'+名). 密设 状 'ended' 真. 得 空.
法.
算 密返 状 码 值 行 列:
    项 取 [码,值,(行 为 句),(列 为 句)]. 序 取 0.
    循 4 次
        指 取 密值 状 ('getelementptr i32, i32* %out, i32 '+(序 为 句)).
        密行 状 ('store i32 '+项[序]+', i32* '+指+', align 4'). 序 取 序+1.
    环. 密行 状 'ret void'. 密设 状 'ended' 真. 得 空.
法.
算 密查 状 坏 码 行 列:
    败 取 密鲜 状 'fail'. 好 取 密鲜 状 'valid'.
    密行 状 ('br i1 '+坏+', label %'+败+', label %'+好).
    密签 状 败. 密返 状 码 '0' 行 列. 密签 状 好. 得 空.
法.
算 密发式 状 式 行 列:
    操 取 式[0].
    若 操 == 'at' 则 得 密发式 状 式[3] 式[1] 式[2]. 然.
    若 操 == 'const' 则
        值 取 式[2] 为 句.
        若 式[1] == 'fact' 则 值 取 '0'. 若 式[2] 则 值 取 '1'. 然. 然.
        得 [值,式[1]].
    然.
    若 操 == 'var' 则
        名 取 式[1]. 型 取 状['env'][名]. 槽 取 状['slots'][名].
        若 槽 != 空 则 得 [(密值 状 ('load '+(密型 型)+', '+(密型 型)+'* '+槽)),型]. 然.
        得 [状['names'][名],型].
    然.
    若 操 == 'length' 则 视 取 密发式 状 式[1] 行 列. 得 [视[0]+'_length','u32']. 然.
    若 操 == 'load' 则
        视 取 密发式 状 式[1] 行 列. 位 取 密发式 状 式[2] 行 列.
        坏 取 密值 状 ('icmp uge i32 '+位[0]+', '+视[0]+'_length'). 密查 状 坏 '1' 行 列.
        宽 取 密值 状 ('zext i32 '+位[0]+' to i64').
        指 取 密值 状 ('getelementptr i8, i8* '+视[0]+', i64 '+宽).
        得 [(密值 状 ('load i8, i8* '+指+', align 1')),'u8'].
    然.
    若 操 == 'truth' 或 操 == 'not' 则
        值 取 密发式 状 式[1] 行 列. 文 取 值[0].
        若 值[1] != 'fact' 则 文 取 '1'. 然.
        若 操 == 'not' 则 文 取 密值 状 ('xor i1 '+文+', true'). 然.
        得 [文,'fact'].
    然.
    左 取 密发式 状 式[1] 行 列.
    若 操 == 'and' 或 操 == 'or' 则
        前 取 状['current']. 右签 取 密鲜 状 'rhs'. 末 取 密鲜 状 'logic'.
        是 取 右签. 否 取 末. 若 操 == 'or' 则 是 取 末. 否 取 右签. 然.
        密行 状 ('br i1 '+左[0]+', label %'+是+', label %'+否).
        密签 状 右签. 右 取 密发式 状 式[2] 行 列. 后 取 状['current'].
        密跳 状 末. 密签 状 末.
        得 [(密值 状 ('phi i1 ['+左[0]+', %'+前+'], ['+右[0]+', %'+后+']')),'fact'].
    然.
    右 取 密发式 状 式[2] 行 列. 型 取 密型 左[1].
    若 操 == 'add' 或 操 == 'sub' 则
        坏 取 ''.
        若 操 == 'add' 则
            上限 取 '4294967295'. 若 左[1] == 'u8' 则 上限 取 '255'. 然.
            余 取 密值 状 ('sub '+型+' '+上限+', '+左[0]).
            坏 取 密值 状 ('icmp ugt '+型+' '+右[0]+', '+余).
        另 坏 取 密值 状 ('icmp ult '+型+' '+左[0]+', '+右[0]). 然.
        密查 状 坏 '2' 行 列.
        得 [(密值 状 (操+' '+型+' '+左[0]+', '+右[0])),左[1]].
    然.
    比 取 {'eq':'eq','ne':'ne','lt':'ult','le':'ule','gt':'ugt','ge':'uge'}[操].
    得 [(密值 状 ('icmp '+比+' '+型+' '+左[0]+', '+右[0])),'fact'].
法.
算 密发块 状 体:
    序 取 0.
    循 (体 其 量) 次
        若 状['ended'] 则 破. 然. 句项 取 体[序]. 操 取 句项[0].
        若 操 == 'set' 则
            值 取 密发式 状 句项[2] 0 0. 型 取 密型 值[1].
            密行 状 ('store '+型+' '+值[0]+', '+型+'* '+状['slots'][句项[1]]).
        另若 操 == 'return' 则
            值 取 密发式 状 句项[1] 0 0. 文 取 值[0].
            若 值[1] == 'u8' 则 文 取 密值 状 ('zext i8 '+文+' to i32'). 然.
            密返 状 '0' 文 0 0.
        另若 操 == 'break' 则 密跳 状 状['loops'][(状['loops'] 其 量)-1].
        另若 操 == 'if' 则
            值 取 密发式 状 句项[1] 0 0.
            是 取 密鲜 状 'yes'. 否 取 密鲜 状 'no'. 末 取 密鲜 状 'endif'.
            密行 状 ('br i1 '+值[0]+', label %'+是+', label %'+否).
            密签 状 是. 密发块 状 句项[2]. 是终 取 状['ended'].
            若 非 是终 则 密跳 状 末. 然.
            密签 状 否. 密发块 状 句项[3]. 否终 取 状['ended'].
            若 非 否终 则 密跳 状 末. 然.
            若 是终 且 否终 则 密设 状 'ended' 真. 另 密签 状 末. 然.
        另若 操 == 'repeat' 则
            数 取 密发式 状 句项[1] 0 0. 槽 取 '%'+(密鲜 状 'counter').
            状['alloc'] 其 增 ('  '+槽+' = alloca i32'). 密行 状 ('store i32 0, i32* '+槽).
            检 取 密鲜 状 'test'. 内 取 密鲜 状 'loop'. 步 取 密鲜 状 'step'. 末 取 密鲜 状 'endloop'.
            密跳 状 检. 密签 状 检. 位 取 密值 状 ('load i32, i32* '+槽).
            条 取 密值 状 ('icmp ult i32 '+位+', '+数[0]).
            密行 状 ('br i1 '+条+', label %'+内+', label %'+末).
            密签 状 内. 状['loops'] 其 增 末. 密发块 状 句项[2]. 状['loops'] 其 弹.
            若 非 状['ended'] 则
                密跳 状 步. 密签 状 步. 后 取 密值 状 ('add i32 '+位+', 1').
                密行 状 ('store i32 '+后+', i32* '+槽). 密跳 状 检.
            然. 密签 状 末.
        然. 序 取 序+1.
    环. 得 空.
法.
算 密LLVM IR 符号:
    # Only internal ASCII identifiers are accepted, never manifest symbol text.
    字 取 __如竞 其 字列 符号. 序 取 0.
    若 (字 其 量) == 0 则 卒 'error: 无效密符号'. 然.
    循 (字 其 量) 次
        字符 取 字[序].
        若 非 ((字符 >= 'a' 且 字符 <= 'z') 或 (字符 >= 'A' 且 字符 <= 'Z') 或 字符 == '_' 或 (序 > 0 且 字符 >= '0' 且 字符 <= '9')) 则 卒 'error: 无效密符号'. 然.
        序 取 序+1.
    环.
    状 取 {'serial':0,'lines':[],'alloc':[],'loops':[],'current':'entry','ended':假,'env':{},'slots':{},'names':{}}.
    参文 取 ['i32* %out']. 转文 取 []. 参 取 IR['params']. 序 取 0.
    循 (参 其 量) 次
        名 取 参[序][0]. 型 取 参[序][1]. 临 取 '%p'+(序 为 句).
        密设 状['env'] 名 型. 密设 状['names'] 名 临.
        若 型 == 'borrow_ro_u8' 则 参文 其 增 ('i8* '+临). 参文 其 增 ('i32 '+临+'_length').
        另
            参文 其 增 ('i32 '+临+'_arg').
            若 型 == 'u8' 则 转文 其 增 ('  '+临+' = trunc i32 '+临+'_arg to i8').
            另 密设 状['names'] 名 (临+'_arg'). 然.
        然. 序 取 序+1.
    环.
    局 取 IR['locals']. 序 取 0.
    循 (局 其 量) 次
        名 取 局[序][0]. 型 取 局[序][1]. 槽 取 '%l'+(序 为 句). 文型 取 密型 型.
        密设 状['env'] 名 型. 密设 状['slots'] 名 槽.
        状['alloc'] 其 增 ('  '+槽+' = alloca '+文型).
        状['alloc'] 其 增 ('  store '+文型+' 0, '+文型+'* '+槽). 序 取 序+1.
    环.
    密发块 状 IR['body'].
