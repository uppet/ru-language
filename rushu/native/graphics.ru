    然.
    项 取 {'op':'','fill':布['填'],'stroke':布['描'],'stroke_width':布['线宽']}.
    若 含 (['三角形','多边形','折线']) 名 则
        点 取 [].
        若 名 == '三角形' 则 数列 宿 节 参. 点 取 [[参[0],参[1]],[参[2],参[3]],[参[4],参[5]]].
