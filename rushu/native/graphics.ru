# Declarative graphics and guest callback lifecycle, implemented in Ru.
# The browser owns rendering. No Python graphics evaluator participates here.
前端 取 外言 '../../bootstrap/compiler.ru'.

形 观值:
    类别 为 句. 资料 为 典.
象.
参数 取 {'背景':['色'],'填色':['色'],'描边':['色'],'线宽':['粗'],'字号':['大小'],'文字对齐':['横向','纵向'],
    '矩形':['横','纵','宽','高'],'椭圆':['横','纵','宽','高'],'弧':['横','纵','宽','高','始角','转角'],'扇形':['横','纵','宽','高','始角','转角'],
    '贝塞尔':['起横','起纵','控一横','控一纵','控二横','控二纵','终横','终纵'],'线':['横一','纵一','横二','纵二'],'文字':['文','横','纵'],
    '三角形':['横一','纵一','横二','纵二','横三','纵三'],'多边形':['点阵'],'折线':['点阵'],'平移':['横','纵'],'旋转':['弧度'],'缩放':['横倍率','纵倍率'],
    '保存':[],'恢复':[],'变换':['a','b','c','d','e','f'],'重置变换':[],'裁剪':['横','纵','宽','高'],'取消裁剪':[],
    '缓存':['宽','高','绘制'],'贴图':['图像','横','纵'],'帧率':['率'],'停':[],'继续':[],'关闭':[],'宽':[],'高':[],'帧':[],'经过秒':[],'间隔秒':[],
    '每帧':['回调'],'鼠标按下':['回调'],'鼠标松开':['回调'],'鼠标移动':['回调'],'按键':['回调'],'松键':['回调']}.
事件名 取 {'每帧':'frame','鼠标按下':'mouse_down','鼠标松开':'mouse_up','鼠标移动':'mouse_move','按键':'key_down','松键':'key_up'}.
元数 取 {'frame':1,'mouse_down':3,'mouse_up':3,'mouse_move':2,'key_down':1,'key_up':1}.
读名 取 ['宽','高','帧','经过秒','间隔秒'].
单位 取 [1,0,0,1,0,0].

算 设 表 名 值: 表 其 增 名 值. 得 空. 法.
算 种 值: 得 __如释 其 种 值. 法.
算 含 列 值: 得 (列 其 查 值) != 空. 法.
算 失败 宿 节 文: 误 取 宿['错']. 误 节 文. 卒 文. 法.
算 JSON 值:
    类 取 种 值.
    若 类 == '句' 则 得 前端 其 JSON句 值. 然.
    若 类 == '空' 则 得 'null'. 然.
    若 类 == '事实' 则 若 值 则 得 'true'. 然. 得 'false'. 然.
    若 类 == '数' 则 得 __如释 其 JSON数 值. 然.
    片 取 [].
    若 类 == '阵' 则
        序 取 0. 循 (值 其 量) 次 片 其 增 (JSON 值[序]). 序 取 序+1. 环.
        得 '['+(__如竞 其 合句 片 ',')+']'.
    然.
    值 其 逐目 作 名 相: 片 其 增 ((前端 其 JSON句 名)+':'+(JSON 相)). 为.
    得 '{'+(__如竞 其 合句 片 ',')+'}'.
法.
算 字节 值: 得 __如释 其 字节 (JSON 值). 法.
算 发 宿 信: 送 取 宿['发']. 送 信. 得 空. 法.
算 检数 宿 节 值 名 低 高 整:
    若 (种 值) != '数' 或 值 < 低 或 值 > 高 或 整 且 值 != (__如竞 其 取整 值) 则
        后 取 '有限数'. 若 整 则 后 取 '整数'. 然. 失败 宿 节 (名+'须为范围内'+后).
    然. 得 值.
法.
算 色 宿 节 值 可空:
    若 可空 且 值 == 空 则 得 ''. 然.
    若 (种 值) != '句' 则 失败 宿 节 '颜色须为 #RRGGBB 或 #RRGGBBAA 文字，空表示不绘制'. 然.
    若 ((值 其 量) != 7 且 (值 其 量) != 9) 或 值[:1] != '#' 则 失败 宿 节 '颜色须为 #RRGGBB 或 #RRGGBBAA 文字'. 然.
    文 取 '#'. 序 取 1. 大 取 {'A':'a','B':'b','C':'c','D':'d','E':'e','F':'f'}.
    循 ((值 其 量)-1) 次
        字 取 值[序]. 若 非 ('0123456789abcdefABCDEF' 其 含 字) 则 失败 宿 节 '颜色须为 #RRGGBB 或 #RRGGBBAA 文字'. 然.
        小 取 大[字]. 若 小 != 空 则 字 取 小. 然. 文 取 文+字. 序 取 序+1.
    环. 得 文.
法.
算 创建 错 调 发信:
    得 {'当前':空,'录制':空,'事件':假,'序':0,'错':错,'调用':调,'发':发信,'可用':假,'预算中':假,'步':0,'始时':0,'存起':0,'钟':0,'节点':{'行':1,'列':1}}.
法.
算 工具: 得 新 观值 类别:'helpers' 资料:{}. 法.
算 几何重置 布: 设 布 '变换' 单位. 设 布 '裁剪' ([]). 设 布 '栈' ([]). 得 空. 法.
算 新布 宽 高 标识 时:
    得 {'宽':宽,'高':高,'标识':标识,'起时':时,'前帧':空,'经过':0,'间隔':0,'帧':0,'率':30,'运行':假,'关闭':假,'脏':真,
        '填':'#4677ff','描':'#202530','线宽':1,'字号':16,'对齐':'left','基线':'top','变换':单位,'裁剪':[],'栈':[],
        '回调':{},'回调序':[],'命令':[],'命令字节':2,'资源':{},'资源字节':2,'像素':0}.
法.
算 关 宿:
    布 取 宿['当前']. 若 布 == 空 则 得 空. 然.
    设 布 '关闭' 真. 设 布 '运行' 假. 设 布 '回调' ({}). 设 布 '回调序' ([]). 设 布 '命令' ([]). 设 布 '资源' ({}).
    设 布 '资源字节' 2. 设 布 '像素' 0. 几何重置 布. 设 宿 '当前' 空.
    发 宿 {'type':'graphics_closed','canvas_id':布['标识']}. 得 空.
法.
算 空场景 布:
    名列 取 布['回调序'][:].
    得 {'type':'graphics','canvas_id':布['标识'],'width':布['宽'],'height':布['高'],'fps':布['率'],'running':布['运行'],'handlers':名列,'commands':[]}.
法.
算 场景 布:
    信 取 空场景 布. 设 信 'commands' 布['命令'].
    引 取 []. 资 取 []. 序 取 0.
    循 (布['命令'] 其 量) 次
        项 取 布['命令'][序].
        若 项['op'] == 'image' 且 非 (含 引 项['resource']) 则
            引 其 增 项['resource']. 资 其 增 布['资源'][项['resource']]['定义'].
        然. 序 取 序+1.
    环.
    若 (资 其 量) > 0 则 设 信 'resources' 资. 然. 得 信.
法.
算 平衡 宿 节 布:
    若 (布['栈'] 其 量) > 0 则
        若 布 == 宿['当前'] 则 关 宿. 然.
        失败 宿 节 '如观保存与恢复须成对；尚有未恢复的状态，已关闭交互'.
    然. 得 空.
法.
算 刷 宿 节:
    布 取 宿['当前']. 若 布 == 空 则 得 空. 然. 平衡 宿 节 布.
    若 布['脏'] 则
        信 取 场景 布. 若 (字节 信) > 262144 则 失败 宿 节 '如观完整绘图帧超过 256 KiB UTF-8 数据；请减少图形或文字'. 然.
        发 宿 信. 设 布 '脏' 假.
    然. 得 空.
法.
算 命令 宿 节 布 项:
    若 项['op'] != 'background' 则
        等 取 真. 序 取 0. 循 6 次 若 布['变换'][序] != 单位[序] 则 等 取 假. 然. 序 取 序+1. 环.
        若 非 等 则 设 项 'transform' 布['变换']. 然.
        若 (布['裁剪'] 其 量) > 0 则 设 项 'clips' 布['裁剪']. 然.
    然.
    长 取 (字节 项)+1.
    若 (布['命令'] 其 量) >= 2048 或 布['命令字节']+长 > 261120 则 失败 宿 节 '如观每帧最多 2048 个绘制命令、256 KiB 数据；请减少图形或文字'. 然.
    布['命令'] 其 增 项. 设 布 '命令字节' (布['命令字节']+长). 设 布 '脏' 真.
    引 取 []. 计 取 布['命令'] 其 量. 序 取 0. 资字节 取 0.
    若 (布['资源'] 其 量) > 0 则
    循 (布['命令'] 其 量) 次
        项目 取 布['命令'][序].
        若 项目['op'] == 'image' 且 非 (含 引 项目['resource']) 则
            引 其 增 项目['resource']. 计 取 计+布['资源'][项目['resource']]['计']. 资字节 取 资字节+布['资源'][项目['resource']]['字节'].
        然. 序 取 序+1.
    环. 然.
    若 计 > 2048 则 失败 宿 节 '如观每帧根命令与引用缓存配方合计最多 2048 个命令'. 然.
    若 布 == 宿['录制'] 则
        若 (布['命令'] 其 量) > 2047 则 失败 宿 节 '如观单张缓存最多 2047 个命令；须为贴图保留一个命令'. 然.
        逗 取 0. 若 (宿['当前']['资源'] 其 量) > 0 则 逗 取 1. 然.
        若 宿['当前']['资源字节']+布['定义开销']+布['命令字节']-3+逗 > 131072 则 失败 宿 节 '如观全部缓存定义最多 128 KiB UTF-8 数据；请减少图形或文字'. 然.
    另 若 (引 其 量) > 0 且 (字节 (空场景 布))+布['命令字节']-3+14+(引 其 量)+资字节 > 262144 则 失败 宿 节 '如观完整绘图帧超过 256 KiB UTF-8 数据；请减少图形或文字'. 然. 然.
    得 空.
法.
算 检时 宿 节:
    时 取 __如释 其 时.
    若 时 < 宿['钟'] 则 关 宿. 失败 宿 节 '如观宿主单调时钟无效；请重新运行'. 然.
    设 宿 '钟' 时. 得 时.
法.
算 预算 宿 节 强:
    若 非 宿['预算中'] 则 得 空. 然.
    设 宿 '步' (宿['步']+1).
    若 非 强 且 宿['步']%128 != 0 则 得 空. 然.
    若 宿['步'] > 500000 则 失败 宿 节 ('如观回调超过执行步预算（实际 '+(宿['步'] 为 句)+' AST 步，阈值 500000 步）；已关闭交互，请简化回调后重跑'). 然.
    时 取 检时 宿 节.
    若 时-宿['始时'] > 1 则 失败 宿 节 ('如观回调超过时间预算（实际约 '+((时-宿['始时']) 为 句)+' 秒墙钟耗时，阈值 1 秒）；已关闭交互，请简化回调后重跑'). 然.
    存 取 (__如释 其 存)-宿['存起'].
    若 存 > 67108864 则 失败 宿 节 ('如观新增内存超过分配预算（实际 '+(存 为 句)+' 字节，阈值 67108864 字节／64 MiB）；已关闭交互，请减少数据后重跑'). 然.
    得 空.
法.
算 合变 宿 节 布 矩:
    旧 取 布['变换'].
    新矩 取 [旧[0]*矩[0]+旧[2]*矩[1],旧[1]*矩[0]+旧[3]*矩[1],旧[0]*矩[2]+旧[2]*矩[3],旧[1]*矩[2]+旧[3]*矩[3],旧[0]*矩[4]+旧[2]*矩[5]+旧[4],旧[1]*矩[4]+旧[3]*矩[5]+旧[5]].
    序 取 0. 循 6 次 检数 宿 节 新矩[序] '如观累积变换' (-100000) 100000 假. 序 取 序+1. 环. 设 布 '变换' 新矩. 得 空.
法.
算 调回 宿 节 函 参:
    若 (种 函) != '释函数' 或 ((函 其 节点)['参'] 其 量) != (参 其 量) 则 失败 宿 节 ('如观回调需要接受 '+((参 其 量) 为 句)+' 个参数的算／作回调'). 然.
    列 取 []. 序 取 0. 循 (参 其 量) 次 列 其 增 [空,参[序]]. 序 取 序+1. 环.
    调 取 宿['调用']. 得 调 节 函 列.
法.
算 成员 宿 节 接收 名 参:
    类 取 接收 其 类别. 布 取 接收 其 资料.
    若 类 == 'helpers' 则
        若 名 == '颜色' 则
            色文 取 '#'. 十六 取 '0123456789abcdef'. 序 取 0.
            循 4 次
                渠 取 检数 宿 节 参[序] '颜色通道' 0 255 真.
                色文 取 色文+十六[__如竞 其 取整 (渠/16)]+十六[渠%16]. 序 取 序+1.
            环. 得 色文.
        然.
        若 非 宿['可用'] 则 失败 宿 节 '如观画布仅在如书会话中可用'. 然.
        若 宿['录制'] != 空 则 失败 宿 节 '如观缓存录制期间不能创建主画布'. 然.
        宽 取 检数 宿 节 参[0] '宽' 1 2048 真. 高 取 检数 宿 节 参[1] '高' 1 2048 真.
        时 取 检时 宿 节. 关 宿. 设 宿 '序' (宿['序']+1).
        新画 取 新布 宽 高 ('native-'+(宿['序'] 为 句)) 时. 设 宿 '当前' 新画. 设 宿 '存起' (__如释 其 存).
        得 新 观值 类别:'canvas' 资料:新画.
    然.
    若 类 == 'image' 则 若 名 == '宽' 则 得 布['宽']. 然. 得 布['高']. 然.
    若 布['关闭'] 或 类 == 'recorder' 且 布 != 宿['录制'] 或 类 != 'recorder' 且 布 != 宿['当前'] 则 失败 宿 节 '如观画布已关闭；运行新代码格、停止或重启会话后，请重新创建画布'. 然.
    若 类 == 'recorder' 且 ((含 (['缓存','贴图','帧率','停','继续','关闭','帧','经过秒','间隔秒']) 名) 或 事件名[名] != 空) 则 失败 宿 节 ('如观缓存绘图目标不支持成员：'+名). 然.
    若 类 != 'recorder' 且 宿['录制'] != 空 且 非 (含 读名 名) 则 失败 宿 节 '如观缓存录制期间不能修改主画布或嵌套缓存'. 然.
    若 含 (['宽','高','帧']) 名 则 得 布[名]. 然.
    若 名 == '经过秒' 则 得 布['经过']. 然. 若 名 == '间隔秒' 则 得 布['间隔']. 然.
    若 事件名[名] != 空 则
        事 取 事件名[名]. 函 取 参[0].
        若 (种 函) != '释函数' 或 ((函 其 节点)['参'] 其 量) != 元数[事] 则 失败 宿 节 (名+'回调参数数量或种类不匹配'). 然.
        若 布['回调'][事] == 空 则 布['回调序'] 其 增 事. 然.
        设 布['回调'] 事 ([函,节]). 若 事 == 'frame' 则 若 非 布['运行'] 则 设 布 '前帧' 空. 然. 设 布 '运行' 真. 然.
    另 若 名 == '缓存' 则 得 缓存 宿 节 布 参.
    另 若 名 == '贴图' 则
        像 取 参[0]. 若 (种 像) != '观值' 或 (像 其 类别) != 'image' 则 失败 宿 节 '贴图需要如观图像'. 然.
        资 取 像 其 资料.
        若 资['主'] != 布 或 布['资源'][资['标识']] == 空 则 失败 宿 节 '如观图像已失效或属于另一画布；请重新创建缓存'. 然.
        命令 宿 节 布 {'op':'image','resource':资['标识'],'x':(检数 宿 节 参[1] '横' (-100000) 100000 假),'y':(检数 宿 节 参[2] '纵' (-100000) 100000 假)}.
    另 若 名 == '关闭' 则 设 布 '栈' ([]). 刷 宿 节. 关 宿.
    另 若 名 == '停' 或 名 == '继续' 则
        运 取 名 == '继续' 且 (__如释 其 有目 布['回调'] 'frame').
        若 运 且 非 布['运行'] 则 设 布 '前帧' 空. 然. 设 布 '运行' 运.
    另 若 名 == '帧率' 则 设 布 '率' (检数 宿 节 参[0] '帧率' 1 30 真).
    另 若 名 == '填色' 或 名 == '描边' 则
        字段 取 '填'. 若 名 == '描边' 则 字段 取 '描'. 然. 设 布 字段 (色 宿 节 参[0] 真).
    另 若 名 == '线宽' 或 名 == '字号' 则 设 布 名 (检数 宿 节 参[0] 名 1 256 假).
    另 若 名 == '文字对齐' 则
        若 (种 参[0]) != '句' 或 (种 参[1]) != '句' 则 失败 宿 节 '文字对齐须使用合法的横向、纵向句'. 然.
        横 取 {'左':'left','中':'center','右':'right'}[参[0]]. 纵 取 {'上':'top','中':'middle','下':'bottom','基线':'alphabetic'}[参[1]].
        若 横 == 空 或 纵 == 空 则 失败 宿 节 '文字对齐须使用合法的横向、纵向句'. 然. 设 布 '对齐' 横. 设 布 '基线' 纵.
    另 若 名 == '保存' 则
        若 (布['栈'] 其 量) >= 64 则 失败 宿 节 '如观最多保存 64 层状态'. 然.
        布['栈'] 其 增 [布['填'],布['描'],布['线宽'],布['字号'],布['对齐'],布['基线'],布['变换'],布['裁剪']].
    另 若 名 == '恢复' 则
        若 (布['栈'] 其 量) == 0 则 失败 宿 节 '如观恢复没有对应的保存'. 然.
        旧 取 布['栈'] 其 弹. 名列 取 ['填','描','线宽','字号','对齐','基线','变换','裁剪']. 序 取 0.
        循 8 次 设 布 名列[序] 旧[序]. 序 取 序+1. 环.
    另 若 名 == '重置变换' 则 设 布 '变换' 单位.
    另 若 名 == '取消裁剪' 则 设 布 '裁剪' ([]).
    另 若 含 (['平移','旋转','缩放','变换']) 名 则
        数列 宿 节 参. 矩 取 参.
        若 名 == '平移' 则 矩 取 [1,0,0,1,参[0],参[1]]. 然.
        若 名 == '缩放' 则 矩 取 [参[0],0,0,参[1],0,0]. 然.
        若 名 == '旋转' 则
            弦 取 (__如释 其 数学 '正弦' 参)[1]. 余 取 (__如释 其 数学 '余弦' 参)[1]. 矩 取 [余,弦,-弦,余,0,0].
        然. 合变 宿 节 布 矩.
    另 若 名 == '裁剪' 则
